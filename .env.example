# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Telegram ---
# Token issued by @BotFather
TELEGRAM_BOT_TOKEN=change-me
# Secret configured on setWebhook(secret_token=...). Telegram echoes it back on
# the X-Telegram-Bot-Api-Secret-Token header of every webhook call; we reject
# any request where it does not match.
TELEGRAM_WEBHOOK_SECRET=change-me

# --- Dev tunnel (docker-compose "ngrok" service) ---
# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=change-me
# A reserved/static domain (https://dashboard.ngrok.com/domains — free tier
# includes one). Using a fixed domain means setWebhook only needs to run
# once; it survives container/tunnel restarts, unlike a random
# *.trycloudflare.com or ephemeral *.ngrok-free.app URL.
NGROK_DOMAIN=change-me.ngrok-free.app

# --- Internal service auth ---
# Static API key an operator/gateway must present when calling non-Telegram
# endpoints (e.g. health/admin). Not used to authenticate end users.
SERVICE_API_KEY=change-me

# --- LLM provider ---
OPENAI_API_KEY=change-me
OPENAI_TEMPERATURE=0.2
# Used to embed the knowledge base corpus (RAG) and per-user long-term memory.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Model Router (agent/model_router.py) ---
# Reasoning tier: the tool-calling agent itself. Utility tier: filler replies
# and conversation summarization — cheap/mechanical activities that don't
# need the strongest model.
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_UTILITY_MODEL=gpt-4o-mini

# --- LangSmith (optional tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-agent

# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Redis (optional cache / rate-limit backend) ---
REDIS_URL=redis://redis:6379/0
USE_REDIS=false

# --- NBA model gateway ---
# "mock" | "sagemaker"
NBA_MODEL_PROVIDER=mock
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=

# --- Loan origination (agent/loan_graph.py) ---
# Applications above this amount (BRL) pause for human approval instead of
# auto-approving. See "Empréstimos" in the README.
LOAN_HUMAN_APPROVAL_THRESHOLD=50000.0

# --- Filler reply (api/routers/telegram_webhook.py) ---
# Only sent if the main agent hasn't replied within this many seconds —
# avoids sending a "hold on" message right before a fast real answer.
FILLER_DELAY_SECONDS=2.5
