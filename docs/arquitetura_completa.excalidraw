      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Deploy — the same FastAPI app\n(main.py) under two runtimes:\n\n1) docker-compose: api + redis\n   (redis-stack-server) + ngrok\n   (fixed tunnel for the webhook)\n\n2) AWS Lambda + API Gateway via\n   Mangum — zero code\n   change",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 120.0,
      "containerId": null,
      "originalText": "Deploy — the same FastAPI app\n(main.py) under two runtimes:\n\n1) docker-compose: api + redis\n   (redis-stack-server) + ngrok\n   (fixed tunnel for the webhook)\n\n2) AWS Lambda + API Gateway via\n   Mangum — zero code\n   change",
      "lineHeight": 1.25
    },
