      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Security (security/)\n\n• telegram_auth — X-Telegram-Bot-Api-\n  Secret-Token, constant-time comparison\n• auth.py — X-Service-Api-Key (admin)\n• rate_limit — per user_id, InMemory\n  or Redis (Settings.use_redis)",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 84.0,
      "containerId": null,
      "originalText": "Security (security/)\n\n• telegram_auth — X-Telegram-Bot-Api-\n  Secret-Token, constant-time comparison\n• auth.py — X-Service-Api-Key (admin)\n• rate_limit — per user_id, InMemory\n  or Redis (Settings.use_redis)",
      "lineHeight": 1.25
    },
