      "updated": 1,
      "link": null,
      "locked": false,
      "text": "AgentExecutor (agent_executor.py)\n\nChatPromptTemplate (system + chat_history +\nhuman + agent_scratchpad)\n↓\ncreate_openai_tools_agent(\n  llm = reasoning OU utility (por complexidade),\n  tools = [5 StructuredTool])\n↓\nAgentExecutor — laço ReAct\nmax_iterations=6, handle_parsing_errors=True\n(output parser interno: OpenAIToolsAgentOutputParser)",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 144.0,
      "containerId": null,
      "originalText": "AgentExecutor (agent_executor.py)\n\nChatPromptTemplate (system + chat_history +\nhuman + agent_scratchpad)\n↓\ncreate_openai_tools_agent(\n  llm = reasoning OU utility (por complexidade),\n  tools = [5 StructuredTool])\n↓\nAgentExecutor — laço ReAct\nmax_iterations=6, handle_parsing_errors=True\n(output parser interno: OpenAIToolsAgentOutputParser)",
      "lineHeight": 1.25
    },
