    {
      "id": "t187",
      "type": "text",
      "x": 1115,
      "y": 1105,
      "width": 630,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3732867543,
      "versionNonce": 1259165906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "It's the ONLY tool with no service-specific error translation — it falls into run_tool's generic catch-all. The human-decision notification (LoanService._notify_customer), on the other hand, is genuinely best-effort: the failure is logged and swallowed, because the decision is already persisted — the customer just misses the immediate notice.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12.0,
      "containerId": null,
      "originalText": "It's the ONLY tool with no service-specific error translation — it falls into run_tool's generic catch-all. The human-decision notification (LoanService._notify_customer), on the other hand, is genuinely best-effort: the failure is logged and swallowed, because the decision is already persisted — the customer just misses the immediate notice.",
      "lineHeight": 1.25
    },
