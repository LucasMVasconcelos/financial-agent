      "updated": 1,
      "link": null,
      "locked": false,
      "text": "CUSTOMER-FACING TRANSLATION LAYER — system_prompt_v4.py (# compliance)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16.0,
      "containerId": null,
      "originalText": "CUSTOMER-FACING TRANSLATION LAYER — system_prompt_v4.py (# compliance)",
      "lineHeight": 1.25
    },
    {
      "id": "t199",
      "type": "text",
      "x": 100,
      "y": 1390,
      "width": 1115.3999999999999,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1122345344,
      "versionNonce": 1880493493,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The LLM never exposes the raw code. It translates each one into a simple sentence:\n\nRATE_LIMITED → \"wait a moment before trying again\"          NOT_FOUND → \"couldn't locate your data right now\"\nUPSTREAM_ERROR / UNKNOWN_ERROR → \"temporary unavailability\"        UNAUTHORIZED / VALIDATION_ERROR → \"sorry, try restarting the conversation\"",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 52.0,
      "containerId": null,
      "originalText": "The LLM never exposes the raw code. It translates each one into a simple sentence:\n\nRATE_LIMITED → \"wait a moment before trying again\"          NOT_FOUND → \"couldn't locate your data right now\"\nUPSTREAM_ERROR / UNKNOWN_ERROR → \"temporary unavailability\"        UNAUTHORIZED / VALIDATION_ERROR → \"sorry, try restarting the conversation\"",
      "lineHeight": 1.25
    },
