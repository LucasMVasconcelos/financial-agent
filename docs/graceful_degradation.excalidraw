    {
      "id": "t187",
      "type": "text",
      "x": 1115,
      "y": 1105,
      "width": 630,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3732867543,
      "versionNonce": 1259165906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "É a ÚNICA tool sem tradução específica de erro por serviço — cai no catch-all genérico de run_tool. Já a notificação da decisão humana (LoanService._notify_customer) é best-effort de verdade: falha é logada e ignorada, porque a decisão já está persistida — o cliente só não recebe o aviso imediato.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12.0,
      "containerId": null,
      "originalText": "É a ÚNICA tool sem tradução específica de erro por serviço — cai no catch-all genérico de run_tool. Já a notificação da decisão humana (LoanService._notify_customer) é best-effort de verdade: falha é logada e ignorada, porque a decisão já está persistida — o cliente só não recebe o aviso imediato.",
      "lineHeight": 1.25
    },
