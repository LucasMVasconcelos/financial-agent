      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Any exception inside the LoanGraph\n(e.g. assess fails fetching the profile)\n— no dedicated error translation here,\nunlike the other 4 tools\n\nAfter it's decided (outside the Tool, via\nthe admin endpoint): sending the customer\nnotification can fail",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
